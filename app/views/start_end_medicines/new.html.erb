<section class="min-vh-100">
  <h1 class="text-center py-5" style="color:#888787; font-weight:bold;">Start End Medicine</h1>
  <div class="d-flex justify-content-center align-items-center">
    <div class="card w-75" style="background: rgba(255, 255, 255, 0.2); backdrop-filter: blur(10px); border-radius: 15px;">
      <div class="row g-0">
        <div class="col-md-6 d-flex justify-content-center align-items-center">
          <!-- Placeholder for Medicine Image -->
          <img
           src="https://images.pexels.com/photos/139398/thermometer-headache-pain-pills-139398.jpeg?auto=compress&cs=tinysrgb&w=600" 
           alt="Add start and end date"
           class="img-fluid object-fit-fill border rounded w-100 h-100"
           style="border-radius: 15px 0 0 15px;"
          />
        </div>
        <div class="col-md-6">
          <div class="card-body">
            <%= render "form", start_end_medicine: @medicine_start_end_medicines, medicine: @medicine %>
            <div class="mt-3">
              <%= link_to "Back to medicines", medicines_path, class:"btn btn-outline-primary" %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
