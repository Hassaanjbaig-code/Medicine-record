<div class="d-flex justify-content-center">
  <div class="card w-100 p-4 glass-effect">
    <%= form_with(model: [medicine, start_end_medicine], id: "#{dom_id(start_end_medicine)}_form", local: true) do |form| %>
      <% if start_end_medicine.errors.any? %>
        <div class="alert alert-danger">
          <h2><%= pluralize(start_end_medicine.errors.count, "error") %> prohibited this start_end_medicine from being saved:</h2>
          <ul>
            <% start_end_medicine.errors.each do |error| %>
              <li><%= error.full_message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
      <div>
        <%= form.label :start_date, style: "display: block" %>
        <%= form.date_field :start_time, class: "form-control" %>
      </div>
      <div>
        <%= form.label :end_date, style: "display: block" %>
        <%= form.date_field :end_time, class: "form-control" %>
      </div>
      <div class="mt-3 d-flex justify-content-center w-100">
        <%= form.submit :Submit, class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
<style>
  .glass-effect {
    background: rgba(255, 255, 255, 0.2);
    border-radius: 10px;
    backdrop-filter: blur(10px);
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }
</style>
