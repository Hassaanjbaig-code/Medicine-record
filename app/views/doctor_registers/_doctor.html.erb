<div class="mb-4" data-controller="appointment-register">
  <div class="card mb-3 border-0 shadow-lg" style="background-color: rgba(255, 255, 255, 0.1); backdrop-filter: blur(10px);">
    <div class="row g-0">
      <div class="col-lg-5 col-md-5 col-sm-6">
        <img src="/assets/Doctor_for_form.jpg" alt="<%= doctor.First_name %>" class="card-img-top rounded-start"/>
      </div>
      <div class="col-lg-7 col-md-7 col-sm-6">
        <div class="card-body">
          <h2 class="card-title font-weight-bold">Dr. <%= doctor.First_name %> <%= doctor.Last_name %></h2>
          <p class="card-text"><strong>Specialization:</strong> <%= doctor.specializations.last.name %></p>
          <p class="card-text"><strong>Available Time:</strong>
            <%= doctor.availabilities.last.available_from.strftime("%I:%M %p") %>
            - 
            <%= doctor.availabilities.last.available_to.strftime("%I:%M %p") %>
          </p>
          <p class="card-text"><strong>Clinic Address:</strong> <%= doctor.clinics.last.address %></p>
          <p class="card-text"><strong>Qualification:</strong> <%= doctor.qualifications.last.qualification_name %></p>
          <div class="d-flex flex-wrap mt-3">
            <%= link_to "Back to Doctors", doctors_path, class: "btn btn-outline-secondary me-2 mb-2" %>
            <%= link_to "Add Appointment", 
            doctor_register_path(doctor), 
            method: :post, 
            data: { controller: "appointment-register", action: "click->appointment-register#show" }, 
            class: "btn btn-outline-primary me-2 mb-2" %>
            <%= link_to "Old Appointment", 
            doctor_register_path(doctor), 
            method: :post, 
            data: { controller: "appointment-register", action: "click->appointment-register#old_show" }, 
            class: "btn btn-outline-primary me-2 mb-2" %>
            <% if room.present? %>
              <%= link_to "Open Message", 
              "#", 
              method: :post, 
              data: { controller: "appointment-register", action: "click->appointment-register#messageApp" }, 
              class: "btn btn-outline-primary me-2 mb-2" %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<style>
  .card-body {
    color: #000;
  }
  .card {
    background-color: rgba(255, 255, 255, 0.8);
    border-radius: 15px;
  }
  .card:hover {
    box-shadow: 0px 10px 15px rgba(0, 0, 0, 0.2);
    transition: box-shadow 0.3s ease-in-out;
  }
</style>