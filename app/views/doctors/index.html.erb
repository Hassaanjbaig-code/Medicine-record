<div class="container min-vh-100">
  <div class="d-flex justify-content-between align-items-center w-100 my-2">
    <h1 class="my-4 font_itim">No Register Doctors</h1>
    <%= link_to "New doctor", new_doctor_path, class: "btn btn-primary", style: "width: 150px; height: 40px;" %>
  </div>
  <div id="doctors">
    <% if @doctors.blank? %>
      <div class="alert alert-warning" role="alert">Please Add your Doctor</div>
    <% else %>
      <div class="list-group">
        <% @doctors.each do |doctor| %>
          <div class="list-group-item bg-transparent">
            <%= render doctor %>
            <p>
              <%= link_to "Show this doctor", doctor, class: "btn btn-primary" %>
            </p>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>