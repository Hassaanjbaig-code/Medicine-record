<div id="<%= dom_id doctor %>" class="card mb-4 glass-effect_1" style="backdrop-filter: blur(10px); background: rgba(255, 255, 255, 0.7);">
  <div class="row no-gutters">
    <div class="col-md-12">
      <div class="card-body">
        <h5 class="card-title"><%= doctor.Fullname %></h5>
        <p class="card-text"><strong>Specialty:</strong> <%= doctor.Specialty %></p>
        <p class="card-text"><strong>Email:</strong> <%= doctor.Email %></p>
        <% doctor.appointments.each do |appointment| %>
          <p class="card-text"><strong>Appointment:</strong> <%= appointment.appointment.strftime('%A, %B %d, %Y at %I:%M') %></p>
          <p class="card-text"><strong>Status:</strong> <%= appointment.status ? "Completed" : "Not Completed" %></p>
        <% end %>
      </div>
    </div>
  </div>
</div>
<style>
  .glass-effect_1 {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 10px;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  padding: 20px;
  }
</style>