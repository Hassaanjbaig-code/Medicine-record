<%= form_with(model: doctor) do |form| %>
  <% if doctor.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(doctor.errors.count, "error") %> prohibited this docter from being saved:</h2>
      <ul>
        <% doctor.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div>
    <%= form.label :Fullname, style: "display: block" %>
    <%= form.text_field :Fullname %>
  </div>
  <div>
    <%= form.label :Specialty, style: "display: block" %>
    <%= form.text_field :Specialty %>
  </div>
  <div>
    <%= form.label :Email, style: "display: block" %>
    <%= form.email_field :Email %>
  </div>
  <div>
    <%= form.submit %>
  </div>
<% end %>
