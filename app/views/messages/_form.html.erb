<%= form_with id: "#{dom_id(Message.new)}_form", url: doctor_register.present? ? doctor_register_messages_path(doctor_register) : patient_messages_path(patient.id), 
                method: :post, 
                local: true do |form| %>
  <div class="form-group">
    <%= form.text_area :content, rows: 3, class: "form-control", placeholder: "Type your message..." %>
  </div>
  <% if current_user.patient %>
    <%= hidden_field_tag "messages[doctor_register_id]", doctor_register.id %>
    <%= hidden_field_tag "messages[patient_id]", current_user.patient.id %>
  <% elsif current_user.doctor_register %>
    <%= hidden_field_tag "messages[doctor_register_id]", current_user.doctor_register.id %>
    <%= hidden_field_tag "messages[patient_id]", patient.id %>
  <% end %>
  <div class="form-group">
    <%= form.submit "Send", class: "btn btn-primary" %>
  </div>
<% end %>