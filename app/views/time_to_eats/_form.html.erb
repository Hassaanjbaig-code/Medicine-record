<div class="col-md-6 p-4 w-100">
  <%= form_with(url: medicine_time_to_eats_path(@medicine), method: :post, id: "#{dom_id(@medicine)}_form", local: true) do |form| %>
    <% if @medicine.errors.any? %>
      <div style="color: red" class="alert alert-primary" role="alert">
        <ul>
          <% @medicine.errors.each do |error| %>
            <li style="list-style-type: none;"><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <div data-controller="nested-form" id="<%= dom_id(@medicine) %>_form" class="mb-3">
      <template data-nested-form-target="template">
        <div class="nested-fields mb-3" id="nested-fields">
          <input type="hidden" name="medicine[time_to_eats_attributes][NEW_RECORD][user_id]" value="<%= @medicine.user_id %>"/>
          <label>Time to eat</label>
          <%= form.text_field :time_to_eat,
             name: "medicine[time_to_eats_attributes][NEW_RECORD][time_to_eat]",
             class: "form-control",
             type: "time",
             style: "color:#666; border:none; border-bottom:2px solid #e6e6e6; border-radius:none; background-color: transparent;" %>
          <button type="button" data-action="nested-form#removeForm" class="btn btn-danger mt-2">Remove</button>
        </div>
      </template>
      <div data-nested-form-target="container">
        <div class="nested-fields mb-3">
          <input type="hidden" name="medicine[time_to_eats_attributes][][user_id]" value="<%= @medicine.user_id %>"/>
          <label>Time to eat</label>
          <%= form.text_field :time_to_eat,
             name: "medicine[time_to_eats_attributes][][time_to_eat]",
             class: "form-control",
             type: "time",
             style: "color:#666; border:none; border-bottom:2px solid #e6e6e6; border-radius:none; background-color: transparent;" %>
        </div>
      </div>
      <button type="button" data-action="nested-form#addForm" class="btn btn-secondary">Add more Time</button>
      <div class="mt-3">
        <%= form.submit "Add Time", class: "btn btn-primary" %>
      </div>
    </div>
  <% end %>
</div>
<style>
  /* Hide spinners in number input fields */
  input::-webkit-outer-spin-button,
  input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  /* Hide spinner for Firefox */
  input[type=number] {
    -moz-appearance: textfield;
  }

  .form-control {
    background-color: transparent !important;
    border-bottom: 2px solid #e6e6e6 !important;
    border-radius: 0 !important;
  }
</style>
