<section class="min-vh-100">
  <h1 class="text-center py-3" style="color:#888787; font-weight:bold;">Add Time</h1>
  <div class="d-flex justify-content-center align-items-center">
    <div class="card w-75" style="background: rgba(255, 255, 255, 0.2); backdrop-filter: blur(10px); border-radius: 15px;">
      <div class="row g-0">
        <div class="col-md-6 d-flex justify-content-center align-items-center">
          <!-- Placeholder for Medicine Image -->
          <img
           src="https://images.pexels.com/photos/6129111/pexels-photo-6129111.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1" 
           alt="Add Time"
           class="img-fluid object-fit-cover border rounded w-100 h-100"
           style="border-radius: 15px 0 0 15px;;"
          />
        </div>
        <div class="col-md-6">
          <div class="card-body">
            <%= render "form", time_to_eat: @time_to_eat, medicine: @medicine %>
            <div class="mt-3">
              <%= link_to "Back to time to eats", medicine_time_to_eats_path, class:"btn btn-outline-primary" %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
