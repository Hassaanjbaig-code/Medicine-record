<div id="<%= dom_id medicine %>" class="mb-4">
  <div class="card mb-3 border-0 shadow-lg" style="background-color: rgba(255, 255, 255, 0.1); backdrop-filter: blur(10px);">
    <div class="row g-0">
      <div class="col-lg-5 col-md-5 col-sm-6">
        <img src="<%= medicine.image %>" alt="<%= medicine.medicine_name %>" class="card-img-top rounded-start"/>
      </div>
      <div class="col-lg-7 col-md-7 col-sm-6">
        <div class="card-body">
          <h2 class="card-title font-weight-bold"><%= medicine.medicine_name %></h2>
          <p class="card-text"><%= medicine.use_for %></p>
          <p class="card-text"><small class="text-muted">MG: <%= medicine.medicine_mg %></small></p>
          <p class="card-text"><small class="text-muted">End Date: 
              <% if medicine.start_end_medicines.empty? %>
                Not Found
              <% else %>
                <%= medicine.start_end_medicines[0].end_time %>
              <% end %>
            </small></p>
          <div class="d-flex flex-wrap mt-3">
            <%= link_to "Edit", edit_medicine_path(medicine), class: "btn btn-outline-primary me-2 mb-2" %>
            <% if medicine.start_end_medicines.blank? %>
              <%= link_to "Add Start End Time", new_medicine_start_end_medicine_path(medicine), class: "btn btn-outline-primary me-2 mb-2" %>
            <% else %>
              <%= link_to "Edit Start End Time", edit_medicine_start_end_medicine_path(medicine, medicine.start_end_medicines[0]), class: "btn btn-outline-primary me-2 mb-2" %>
            <% end %>
            <%= link_to "Back to Medicines", medicines_path, class: "btn btn-outline-secondary me-2 mb-2" %>
            <%= button_to "Destroy", medicine, method: :delete, class: "btn btn-outline-danger mb-2" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<style>
  .card-body {
    color: #000;
  }
  .card {
    background-color: rgba(255, 255, 255, 0.8);
    border-radius: 15px;
  }
  .card:hover {
    box-shadow: 0px 10px 15px rgba(0, 0, 0, 0.2);
    transition: box-shadow 0.3s ease-in-out;
  }
</style>
