<section class="min-vh-100">
  <div class="container">
    <div class="row my-2">
      <div class="col">
        <%= month_calendar(events: @medicines) do | date, medicines | %>
          <div class="position-relative">
            <div class="day">
              <%= date.day %>
            </div>
            <ul class="list-group">
              <% medicines.each do | med | %>
                <li class="position-absolute list-group-item top-0 start-50 badge badge-success badge-pill rounded-circle p-1 d-flex justify-content-center align-items-center"
               data-bs-toggle="tooltip" 
               data-bs-placement="top"
               title="<%= med.medicine_name %>" style="font-size: 0.5rem; background-color: #28a745; width: 1rem; height: 1rem;">
                  <span class=""><%= medicines.length %></span>
                  <span class="visually-hidden">New alerts</span>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  <div class="d-flex justify-content-end my-2 mx-2">
    <%= link_to "New medicine", new_medicine_path, class: "btn btn-primary" %>
  </div>
  <div class="grid" data-controller="push" data-application-server-key="<%= Rails.application.credentials.dig(:Webpush, :public_key) %>">
    <div id="medicines" class="row row-cols-lg-4 row-cols-md-2 ml-5 mx-auto">
      <% @medicines.each do |medicines| %>
        <div class="col order-first">
          <div class="card mb-3 d-md-block" style="width: 18rem; background-color: transparent !important;">
            <%= render "medicines", medicine: medicines %>
          </div>
        </div>
      <% end %>
    </div>
    <%# <button data-action="push#PushNotification">
      Send a Message
    </button> %>
  </div>
</section>