<section class="container min-vh-100 d-flex justify-content-center align-items-center">
  <div class="card w-75" style="background: rgba(255, 255, 255, 0.2); backdrop-filter: blur(10px); border-radius: 15px;">
    <div class="row d-flex justify-content-center align-items-center">
      <div class="col-md-6 d-flex align-items-center justify-content-center">
        <%= image_tag "main_image.jpg", alt: "Sign up image", class: "img-fluid object-fit-cover border rounded w-100 h-100" %>
      </div>
      <div class="col-md-6">
        <div class="card-body">
          <h2 class="text-center py-3" style="color:#888787; font-weight:bold;">Sign up</h2>
          <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "w-100" }) do |f| %>
            <%= render "devise/shared/error_messages", resource: resource %>
            <!-- Name input -->
            <div data-mdb-input-init class="form-outline mb-4">
              <%= f.label :name, class: "form-label", for: "form1Example0" %>
              <%= f.text_field :name, id: "form1Example0", class: "form-control", autofocus: true, autocomplete: "name", required: true %>
            </div>
            <!-- Email input -->
            <div data-mdb-input-init class="form-outline mb-4">
              <%= f.label :email, class: "form-label", for: "form1Example1" %>
              <%= f.email_field :email, id: "form1Example1", class: "form-control", autofocus: true, autocomplete: "email", required: true %>
            </div>
            <!-- Password input -->
            <div data-mdb-input-init class="form-outline mb-4">
              <%= f.label :password, class: "form-label", for: "form1Example2" %>
              <%= f.password_field :password, id: "form1Example2", class: "form-control", autocomplete: "new-password", required: true %>
              <% if @minimum_password_length %>
                <em>(<%= @minimum_password_length %> characters minimum)</em>
              <% end %>
            </div>
            <!-- Password confirmation input -->
            <div data-mdb-input-init class="form-outline mb-4">
              <%= f.label :password_confirmation, class: "form-label", for: "form1Example4" %>
              <%= f.password_field :password_confirmation, id: "form1Example4", class: "form-control", autocomplete: "new-password", required: true %>
            </div>
            <!-- Custom partial rendering -->
            <%= render partial: "timezone", locals: { f: f, class_name: "d-none" } %>
            <!-- Submit button -->
            <%= f.submit "Sign up", class: "btn btn-primary btn-block", data: { mdb_ripple_init: true } %>
          <% end %>
          <%= render "devise/shared/links" %>
        </div>
      </div>
    </div>
  </div>
</section>